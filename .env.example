# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mercado Pago
VITE_MP_PUBLIC_KEY=

# Modo do checkout: 'pro' ou 'transparent'
VITE_MP_CHECKOUT_MODE=transparent

# Mercado Pago Access Token (usado nas Edge Functions — NÃO expor no frontend)
# Configurar via: supabase secrets set MP_ACCESS_TOKEN=<token>

# PIX
VITE_PIX_KEY=
VITE_PIX_NAME=
VITE_PIX_CITY=

# WhatsApp
VITE_WHATSAPP_NUMBER=

# App version (date-based, e.g. 2026.05.07)
VITE_APP_VERSION=
